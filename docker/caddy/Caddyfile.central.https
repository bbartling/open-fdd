# HTTPS edge for Open-FDD Central (static UI at /app/, API at /api/, docs at /docs).
# Default when OPENFDD_CADDY=1 on portal/csv recipes. TLS via Caddy `tls internal`.
# Security headers and CSP are set by central — do not override them here.

{
	admin off
}

http://:80 {
	redir https://{host}{uri} permanent
}

:443 {
	encode gzip zstd
	tls internal

	@blocked path /.env /.git /.git/* /wp-admin /wp-admin/* /xmlrpc.php
	respond @blocked 404

	redir /login /auth 302

	reverse_proxy {$OPENFDD_CADDY_UPSTREAM:central:8080} {
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}
