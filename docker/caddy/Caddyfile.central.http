# Plain HTTP edge for Open-FDD Central (lab opt-out: OPENFDD_CADDY_TLS=0).
# Upstream is central:8080 (/app, /api, /docs). CSP stays on central responses.

{
	admin off
	auto_https off
}

:80 {
	encode gzip zstd

	@blocked path /.env /.git /.git/* /wp-admin /wp-admin/* /xmlrpc.php
	respond @blocked 404

	redir /login /auth 302

	reverse_proxy {$OPENFDD_CADDY_UPSTREAM:central:8080} {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}
