{
  "_doc": "Quantity -> SI unit, accepted unit spellings and display conversions. Data reaching a renderer is always SI; convert for display only, with value * mul + add. Spellings are matched after the same normalisation as nf-app/static/units.js (trim, lower-case, drop spaces and underscores, 2-subscript to 2, masculine ordinal to degree). ingest: si = value * to_si.mul + to_si.add. An alias quantity named in refine (pressure, flow, percent) is refined by the point's markers; any other is the quantity itself.",
  "version": 1,
  "quantities": {
    "temperature": {
      "family": "temperature",
      "si": "°C",
      "axis": "temp",
      "kind": "absolute",
      "display": {
        "si": {
          "unit": "°C",
          "mul": 1,
          "add": 0
        },
        "imperial": {
          "unit": "°F",
          "mul": 1.8,
          "add": 32
        }
      },
      "units_js": {
        "fn": "fromSI",
        "si": "°C"
      }
    },
