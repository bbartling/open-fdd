# Copy to scripts/nf/.env — chmod 600 — never commit .env
#
# Remote (any host → Cloudflare tunnel → bosspi NF):
# 1) Portal device bosspi → Tunnel → Allow unauthenticated
# 2) Console → Settings → Authorization → API keys → create (copy secret once)
# 3) Fill below and run: python3 scripts/nf/read_sensors.py

NFURL=https://6639ffc3-4264-45d3-ba48-e81f451b33d1.normal-online.net
NF_CLIENT_ID=
NF_CLIENT_SECRET=
# Comma-separated provider point UUIDs (not display names).
NF_POINT_UUIDS=

# Lab-only LAN (optional; open query on this bench):
# NFURL=http://192.168.204.12:8090
