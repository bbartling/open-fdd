{
  "application": {
    "id": "open-fdd",
    "name": "Open-FDD",
    "description": "Open-FDD fault detection and diagnostics as a Normal Framework app (ADR-014). Source of truth: open-fdd nf-app/",
    "runtime": "RUNTIME_NODE_JS",
    "auth": {
      "apiKey": {
        "scopes": [
          "normalgw.hpl.v1.readwrite",
          "normalgw.hpl.v2.readwrite",
          "normalgw.ontology.v1.readonly",
          "normalgw.automation.v1.readonly"
        ]
      }
    }
  },
  "files": {
    "/static/app.js": "static/app.js",
    "/static/chart-page.js": "static/chart-page.js",
    "/static/chart.html": "static/chart.html",
    "/static/charts.js": "static/charts.js",
    "/static/echarts-global.js": "static/echarts-global.js",
    "/static/fdd-catalog.json": "static/fdd-catalog.json",
    "/static/fdd.js": "static/fdd.js",
    "/static/index.html": "static/index.html",
    "/static/model.js": "static/model.js",
    "/static/nf.js": "static/nf.js",
    "/static/style.css": "static/style.css",
    "/static/theme-init.js": "static/theme-init.js",
    "/static/theme.js": "static/theme.js",
    "/static/tree.css": "static/tree.css",
    "/static/tree.html": "static/tree.html",
    "/static/tree.js": "static/tree.js",
    "/static/vendor/echarts.esm.min.js": "static/vendor/echarts.esm.min.js",
    "/hooks/weather.js": "hooks/weather.js",
    "/hooks/fdd.js": "hooks/fdd.js",
    "/hooks/lib/engines.js": "hooks/lib/engines.js",
    "/rules/pack-sqlite.json": "rules/pack-sqlite.json",
    "/rules/pack-postgres.json": "rules/pack-postgres.json",
    "/package.json": "package.json",
    "/hooks/vendor/sql.js/sql-wasm.js": "hooks/vendor/sql.js/sql-wasm.js",
    "/hooks/vendor/sql.js/sql-wasm.wasm": "hooks/vendor/sql.js/sql-wasm.wasm",
    "/hooks/vendor/sql.js/LICENSE": "hooks/vendor/sql.js/LICENSE"
  },
  "hooks": [
    {
      "id": "weather",
      "name": "weather",
      "entryPoint": "/hooks/weather.js",
      "points": {
        "noPoints": true,
        "globalVariables": [
          {
            "label": "oa_dry_bulb_web",
            "attrs": {
              "description": "Outdoor air dry bulb (Open-Meteo, NF site coordinates)",
              "units": "degF",
              "source": "open-meteo"
            }
          },
          {
            "label": "oa_rh_web",
            "attrs": {
              "description": "Outdoor air relative humidity (Open-Meteo, NF site coordinates)",
              "units": "%",
              "source": "open-meteo"
            }
          },
          {
            "label": "oa_dewpoint_web",
            "attrs": {
              "description": "Outdoor air dewpoint (Open-Meteo, Magnus fallback, NF site coordinates)",
              "units": "degF",
              "source": "open-meteo"
            }
          }
        ]
      },
      "schedule": {
        "rrule": "DTSTART:20261101T000000Z\nRRULE:FREQ=MINUTELY;INTERVAL=20"
      },
      "mode": "MODE_SCHEDULED",
      "invokeTimeout": "60s"
    },
    {
      "id": "fdd",
      "name": "fdd",
      "entryPoint": "/hooks/fdd.js",
      "points": {
        "noPoints": true
      },
      "config": {
        "engine": "auto",
        "windowHours": 24
      },
      "schedule": {
        "rrule": "DTSTART:20261101T000700Z\nRRULE:FREQ=HOURLY;INTERVAL=1"
      },
      "mode": "MODE_SCHEDULED",
      "invokeTimeout": "300s"
    }
  ]
}
