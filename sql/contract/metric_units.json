{
  "contract_id": "openfdd-metric-units-v1",
  "contract_version": "4.0.0",
  "processing_abi_current": "metric-c-v2",
  "notes": [
    "Canonical processing and storage ABI is metric-c-v2 (°C, Δ°C, Pa, kPa, L/s, kW, kWh).",
    "Rule SQL and historian values remain imperial-f-v1 on running stacks until W4 ingest/cutover land.",
    "Declared source units convert once at ingest (W2b) or cutover (W2c); no query-time admit after W2b.",
    "Display preference is independent of processing and must not use ±32 on deltas/rates.",
    "Percent 0–100 vs fraction 0–1 is declared metadata — never inferred from magnitude.",
    "Parameter SI renames are published in parameter_si_rename_map.json; registry keys stay until W4/W2c migration.",
    "Pa per in.w.c. constant matches fdd_core::units::PA_PER_IN_WC (248.84)."
  ],
  "quantities": [
    {
      "id": "absolute_temperature",
      "canonical_unit": "degC",
      "aliases": ["C", "°C", "degC", "celsius", "F", "°F", "degF", "fahrenheit"]
    },
    {
      "id": "temperature_difference",
      "canonical_unit": "delta_degC",
      "conversion": "scale_only",
      "aliases": ["deltaC", "Δ°C", "K_diff", "deltaF", "Δ°F", "degF_delta", "degC_delta"]
    },
    {
      "id": "temperature_rate",
      "canonical_unit": "delta_degC_per_h",
      "conversion": "scale_only",
      "aliases": [
        "delta_degC_per_h",
        "Δ°C/h",
        "degC_per_h",
        "delta_degF_per_h",
        "degF_per_h",
        "Δ°F/h"
      ]
    },
    {
      "id": "air_pressure",
      "canonical_unit": "Pa",
      "aliases": ["Pa", "pascal", "inH2O", "in.w.c.", "in_wc", "inwc"]
    },
    {
      "id": "hydronic_pressure",
      "canonical_unit": "kPa",
      "aliases": ["kPa", "psi"]
    },
    {
      "id": "volumetric_flow",
      "canonical_unit": "L_per_s",
      "aliases": ["L/s", "lps", "L_per_s", "cfm", "gpm", "m3/s"]
    },
    {
      "id": "power",
      "canonical_unit": "kW",
      "aliases": ["kW", "W", "kw"]
    },
    {
      "id": "interval_energy",
      "canonical_unit": "kWh",
      "aliases": ["kWh", "Wh", "kwh"]
    },
    {
