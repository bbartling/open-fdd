    },
    {
      "id": "air_pressure",
      "canonical_unit": "Pa",
      "aliases": ["Pa", "pascal", "inH2O", "in.w.c.", "in_wc", "inwc"]
    },
    {
      "id": "hydronic_pressure",
      "canonical_unit": "kPa",
      "aliases": ["kPa", "psi"]
    },
    {
      "id": "volumetric_flow",
      "canonical_unit": "L_per_s",
      "aliases": ["L/s", "lps", "L_per_s", "cfm", "gpm", "m3/s"]
    },
    {
      "id": "power",
      "canonical_unit": "kW",
      "aliases": ["kW", "W", "kw", "kBtu/h", "ton"]
    },
    {
      "id": "interval_energy",
