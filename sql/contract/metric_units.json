      "aliases": ["frac", "fraction", "fraction_0_1"]
    },
    {
      "id": "relative_humidity",
      "canonical_unit": "percent_0_100",
      "aliases": ["%RH", "RH", "percent_relative_humidity"]
    },
    {
      "id": "status",
      "canonical_unit": "boolean",
      "aliases": ["bool", "boolean"]
    },
    {
      "id": "occupancy_mode",
      "canonical_unit": "enum_text"
    }
  ],
  "parameter_kinds": [
    "absolute_temperature",
    "temperature_difference",
    "temperature_rate",
    "air_pressure",
    "hydronic_pressure",
    "volumetric_flow",
