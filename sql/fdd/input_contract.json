{
  "_doc": "Canonical engine-independent scratch input contract. Role names and units are roles/openfdd-roles.json (QUDT local names). Values are SI on the wire: temperatures DEG_C, pressure PA, flow L-PER-SEC, damper/valve/fan-speed PERCENT 0-100, start/stop commands boolean 0/1. legacy_keys resolve old names. supply_fan_speed_command is read by FC1 and is not a rule_input in 1.1.0.",
  "version": 3,
  "sources": {
    "point": {
      "table": "fdd.point",
      "definition": "sql/fdd/schema/core.sql",
      "key": [
        "site_id",
        "point_key"
      ]
    },
    "input_sample": {
      "kind": "view",
      "name": "fdd.input_sample",
      "doc": "Long SI samples, NULL values removed. value is in the SI unit of the point's role (fdd.point.unit); the view applies fdd.point.si_scale/si_offset when the store keeps native units. Loaders always filter site_id = $1 AND point_key = ANY($2) AND ts >= $3 AND ts < $4.",
      "columns": {
        "site_id": {
          "type": "text"
        },
        "point_key": {
          "type": "text"
        },
        "ts": {
          "type": "timestamp"
        },
        "value": {
          "type": "double"
        }
      },
      "join": "fdd.point (site_id, point_key)"
    }
  },
