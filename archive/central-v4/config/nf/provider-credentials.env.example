# Copy to config/nf/provider-credentials.env (gitignored) or another path outside git.
# chmod 600. Referenced by OPENFDD_NF_PROVIDER_CREDENTIALS_ENV in repo-root .env.
# Only NF portal credential names referenced as env:... in provider_sites JSON belong here.
# Do not put OPENFDD_JWT_SECRET, Timescale passwords, or other stack secrets in this file.

# Per-site pattern (site slug UPPER_SNAKE in provider JSON):
# NF_CLIENT_ID_SITE_A=replace-me
# NF_CLIENT_SECRET_SITE_A=replace-me
# NFURL_SITE_A=https://installation-uuid.example.com

# Legacy single-site (one portal only):
# NFURL=https://installation-uuid.example.com
# NF_CLIENT_ID=replace-me
# NF_CLIENT_SECRET=replace-me
