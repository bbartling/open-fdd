{
  "replaces": ["bench-viz", "open-meteo-weather"],
  "application": {
    "id": "open-fdd-lite",
    "name": "Open-FDD Lite",
    "description": "Open-FDD Lite: the small-box edition for Normal Framework. Tag-driven dashboard, charts, BACnet server view, RDF export, an Open-Meteo weather hook, and an hourly FDD hook on server-side Node DuckDB. Source of truth: open-fdd lite/",
    "runtime": "RUNTIME_NODE_JS",
    "auth": {
      "apiKey": {
        "scopes": [
          "normalgw.hpl.v1.readwrite",
          "normalgw.hpl.v2.readwrite",
          "normalgw.bacnet.v1.readwrite",
          "normalgw.bacnet.v2.readwrite",
          "normalgw.ontology.v1.readonly"
        ]
      }
    }
  },
  "files": {
    "/hooks/lib/paging.js": "hooks/lib/paging.js",
    "/hooks/lib/settings.js": "hooks/lib/settings.js",
    "/hooks/lib/start-hook-args.js": "hooks/lib/start-hook-args.js",
    "/hooks/open_meteo_weather.js": "hooks/open_meteo_weather.js",
    "/hooks/rdf.js": "hooks/rdf.js",
    "/static/app-core.js": "static/app-core.js",
    "/static/app.js": "static/app.js",
    "/static/base.css": "static/base.css",
    "/static/chart-page.js": "static/chart-page.js",
    "/static/chart.html": "static/chart.html",
    "/static/charts.js": "static/charts.js",
    "/static/index.html": "static/index.html",
    "/static/model.js": "static/model.js",
    "/static/roles/openfdd-roles.json": "static/roles/openfdd-roles.json",
    "/static/roles/role-binding.json": "static/roles/role-binding.json",
    "/static/roles/roles-223p.ttl": "static/roles/roles-223p.ttl",
    "/static/roles/roles.sha256": "static/roles/roles.sha256",
    "/static/nf.js": "static/nf.js",
    "/static/paging.js": "static/paging.js",
    "/static/style.css": "static/style.css",
    "/static/theme-init.js": "static/theme-init.js",
    "/static/theme.js": "static/theme.js",
    "/static/tree.css": "static/tree.css",
    "/static/tree.html": "static/tree.html",
    "/static/tree.js": "static/tree.js",
    "/static/vendor/echarts.min.js": "static/vendor/echarts.min.js",
    "/static/version.js": "static/version.js",
    "/package.json": "package.json",
    "/hooks/fdd.js": "../nf-app/hooks/fdd.js",
    "/hooks/lib/engines.js": "../nf-app/hooks/lib/engines.js",
    "/hooks/lib/duckdb-parquet.js": "../nf-app/hooks/lib/duckdb-parquet.js",
    "/hooks/lib/engine-build.js": "../nf-app/hooks/lib/engine-build.js",
    "/hooks/lib/role-limits.js": "../nf-app/hooks/lib/role-limits.js",
    "/hooks/lib/rule-tuning.js": "../nf-app/hooks/lib/rule-tuning.js",
    "/hooks/lib/site-timezone.js": "../nf-app/hooks/lib/site-timezone.js",
    "/static/units.js": "../nf-app/static/units.js",
    "/static/fdd.js": "../nf-app/static/fdd.js",
    "/static/run-proof.js": "../nf-app/static/run-proof.js",
    "/static/schedule.js": "../nf-app/static/schedule.js",
    "/static/occupancy.js": "../nf-app/static/occupancy.js",
    "/static/fdd-catalog.json": "../nf-app/static/fdd-catalog.json",
    "/static/engine-build.json": "../nf-app/static/engine-build.json",
    "/rules/pack-postgres.json": "../nf-app/rules/pack-postgres.json"
  },
  "hooks": [
    {
      "id": "open-meteo-weather",
      "name": "open-meteo-weather",
      "entryPoint": "/hooks/open_meteo_weather.js",
      "points": {
        "noPoints": true,
        "globalVariables": [
          {
            "label": "oa_dry_bulb_web",
            "attrs": {
              "bacnet_object": "av.1",
              "description": "Outdoor air dry bulb (Open-Meteo, NF site coordinates)",
              "units": "degF",
              "source": "open-meteo"
            }
          },
          {
            "label": "oa_rh_web",
            "attrs": {
              "bacnet_object": "av.2",
              "description": "Outdoor air relative humidity (Open-Meteo, NF site coordinates)",
              "units": "%",
              "source": "open-meteo"
            }
          },
          {
            "label": "oa_dewpoint_web",
            "attrs": {
              "bacnet_object": "av.3",
              "description": "Outdoor air dewpoint (Open-Meteo, NF site coordinates)",
              "units": "degF",
              "source": "open-meteo"
            }
          }
        ]
      },
      "config": {
        "site": "",
        "avInstances": [
          1,
          2,
          3
        ]
      },
      "schedule": {
        "rrule": "DTSTART:20261101T000000Z\nRRULE:FREQ=MINUTELY;INTERVAL=20"
      },
      "mode": "MODE_SCHEDULED",
      "invokeTimeout": "190s"
    },
    {
      "id": "fdd",
      "name": "fdd",
      "entryPoint": "/hooks/fdd.js",
      "points": {
        "noPoints": true
      },
      "config": {
        "engine": "duckdb",
        "windowHours": 24
      },
      "schedule": {
        "rrule": "DTSTART:20261101T000700Z\nRRULE:FREQ=HOURLY;INTERVAL=1"
      },
      "mode": "MODE_SCHEDULED",
      "invokeTimeout": "300s"
    },
    {
      "id": "rdf",
      "name": "rdf",
      "entryPoint": "/hooks/rdf.js",
      "points": {
        "noPoints": true
      },
      "mode": "MODE_ON_REQUEST",
      "invokeTimeout": "60s"
    }
  ]
}
