# Open-FDD (NF app) — local tooling environment. Copy to a private file outside the repo,
# e.g. ~/.secrets/nf_<site>_console.env, and pass it with --env. Never commit real values.
#
#   python3 scripts/nf/hooks/nf_app_sync.py --env ~/.secrets/nf_site_console.env push nf-app/app.json
#
# NF console (local, not the portal): the URL tools use to deploy the app and its hooks.
# Behind the Caddy front door (deploy/nf-caddy) this is the LAN URL + the Caddy login.
NF_CONSOLE_URL=http://192.0.2.10:8090
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=change-me

# Read-only API key for scripts that read through the Normal Online portal (optional).
# NF_CLIENT_ID=
# NF_CLIENT_SECRET=
# NFURL=https://<instance-uuid>.normal-online.net
