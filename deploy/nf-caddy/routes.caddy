# Which NF URLs are open and which need a login. Imported by Caddyfile (plain HTTP)
# and Caddyfile.tls (HTTPS), so both front doors apply the same rules.
#
#   open (no login)  NF app static pages + the read-only API calls they make
#   basic auth       everything else: NF console, app/hook config, every write
#
# The login lives in /etc/caddy/auth.caddy (one line: `<user> <bcrypt hash>` from
# `caddy hash-password`) and is never committed.

# App pages (Open-FDD dashboard and any other NF app) — files only, no app config.
# (+ NF's favicon: browsers ask for /favicon.ico on every page, else a 401 per load)
@appStatic {
	method GET HEAD
	path /api/v1/apps/static/* /favicon.ico
}
@favicon path /favicon.ico
# Read-only API the pages use: history, platform info, BACnet server reads.
@readGet {
	method GET HEAD
	path /api/v1/point/data /api/v1/platform/info
	path /api/v1/bacnet/configuration /api/v1/bacnet/local /api/v1/bacnet/ports /api/v1/bacnet/readproperty
}
# Reads that are POSTs in NF's API; the token call still needs a client id/secret.
@readPost {
	method POST
	path /api/v1/point/query /api/v1/auth/token
}
# Live values NF pushes (PointManager.ObserveDataUpdates, read-only, one long
# chunked response). Flush every chunk at once instead of buffering it.
@liveStream {
	method GET
	path /api/v1/point/updates/data
}

# Access log: one JSON line per request, rolled by size, secrets redacted.
#   - Authorization / Cookie / Set-Cookie headers and token-like query parameters never reach the file.
#   - Bounded: 5 MiB per file, 5 files kept, nothing older than 30 days (roll_*), on the caddy_logs volume.
#   - Not logged at all (log_skip): /favicon.ico and the live stream (one line per ~15 s per open tab,
#     it would push everything useful out of the 5 files).
# Everything that needs a decision (who got in, what was written, which status) is in the file.
log_skip @favicon
log_skip @liveStream
log {
	output file /var/log/caddy/access.log {
		roll_size 5MiB
		roll_keep 5
		roll_keep_for 720h
	}
	format filter {
		wrap json
		request>headers>Authorization replace REDACTED
		request>headers>Proxy-Authorization replace REDACTED
		request>headers>Cookie replace REDACTED
		resp_headers>Set-Cookie replace REDACTED
		request>uri query {
			replace token REDACTED
			replace access_token REDACTED
			replace id_token REDACTED
			replace refresh_token REDACTED
			replace jwt REDACTED
			replace api_key REDACTED
			replace apikey REDACTED
			replace client_secret REDACTED
			replace secret REDACTED
			replace password REDACTED
			replace sig REDACTED
			replace code REDACTED
		}
	}
}

# Security headers on every response (ZAP baseline: clickjacking, MIME sniffing, permissions).
# frame-ancestors can't be set from the pages' <meta> CSP, so it lives here; the meta CSP still
# governs scripts/styles. NF's console may frame its own pages, hence 'self' (not 'none').
header {
	X-Content-Type-Options "nosniff"
	X-Frame-Options "SAMEORIGIN"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), payment=()"
	Content-Security-Policy "frame-ancestors 'self'"
	-Server
}

# Compress everything except the live stream (it must flush chunk by chunk).
@compress not path /api/v1/point/updates/data
encode @compress gzip

handle @liveStream {
	reverse_proxy {$NF_UPSTREAM} {
		flush_interval -1
		# Why this rewrite exists: NF's Envoy closes a push stream that has been quiet for ~15 s
		# ("upstream request timeout", HTTP 504). That is Envoy's normal idle close, not an outage:
		# nf.js reopens the stream at once. Without the rewrite every such reconnect shows up as a
		# red 504 in the browser console and the network tab. ONLY upstream 504s on this one route
		# are rewritten (to an empty 204), so an Envoy 504 for any other reason on this route is
		# hidden too; a real outage is not hidden by it: NF down or Caddy
		# unreachable gives connection errors (502 from Caddy, refused/reset), and the page
		# reports the failed reconnects ("live" turns off and backs off 2 s .. 60 s).
		@quiet status 504
		handle_response @quiet {
			respond 204
		}
	}
}
handle @appStatic {
	reverse_proxy {$NF_UPSTREAM}
}
handle @readGet {
	reverse_proxy {$NF_UPSTREAM}
}
handle @readPost {
	reverse_proxy {$NF_UPSTREAM}
}
handle {
	basic_auth {
		import /etc/caddy/auth.caddy
	}
	reverse_proxy {$NF_UPSTREAM}
}
