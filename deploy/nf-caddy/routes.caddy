# Which NF URLs are open and which need a login. Imported by Caddyfile (plain HTTP,
# Full and Lite) and Caddyfile.tls (HTTPS), so both front doors apply the same rules.
# Lite sets APP_ID=open-fdd-lite; the matchers below name both app ids explicitly.
#
#   open (no login)     the Open-FDD static app and the read-only calls the page makes
#   no challenge        two calls the page makes that must not pop a browser login dialog
#                       and must not succeed anonymously (app listing, tuning hook)
#   basic auth          everything else: NF console, app config, every write
#
# The login lives in auth.caddy next to this file (one line: `<user> <bcrypt hash>` from
# `caddy hash-password`) and is never committed.
#
# A 401 with WWW-Authenticate on any sub-resource makes the browser show its login dialog
# even when the dashboard document itself is open. Public routes never do that. The two
# no-challenge routes answer 403 with no WWW-Authenticate when the request has no
# Authorization header, and still require the login when a credential is presented.

# App pages (Open-FDD and Lite, files only) plus the icons browsers request from the
# origin on every load. A 401 on those icons is enough to pop the dialog.
@appStatic {
	method GET HEAD
	path /api/v1/apps/static/* /favicon.ico /favicon.png /favicon.svg /apple-touch-icon.png /apple-touch-icon-precomposed.png
}
@browserIcons path /favicon.ico /favicon.png /favicon.svg /apple-touch-icon.png /apple-touch-icon-precomposed.png
# Read-only GETs the dashboard uses: history, platform info, BACnet server reads,
# site timezone, occupancy schedules.
@readGet {
	method GET HEAD
	path /api/v1/point/data /api/v1/platform/info
	path /api/v1/bacnet/configuration /api/v1/bacnet/local /api/v1/bacnet/ports /api/v1/bacnet/readproperty
	path /api/v1/sites /api/v1/sites/* /api/v1/schedules /api/v1/schedules/*
}
# Reads that are POSTs in NF's API. point/query and auth/token were already open.
# schema and analytics are read-only hooks the page starts while it draws; the same
# POST on fdd, history, weather, tuning or sparql is not listed here.
@readPost {
	method POST
	path /api/v1/point/query /api/v1/auth/token
	path /api/v1/apps/open-fdd/hooks/schema /api/v1/apps/open-fdd-lite/hooks/schema
	path /api/v1/apps/open-fdd/hooks/analytics /api/v1/apps/open-fdd-lite/hooks/analytics
}
# Results of those two hooks only (the page polls them). Not other hooks' run logs.
@hookRuns {
	method GET HEAD
	path /api/v1/apps/open-fdd/hooks/schema/runs /api/v1/apps/open-fdd-lite/hooks/schema/runs
	path /api/v1/apps/open-fdd/hooks/analytics/runs /api/v1/apps/open-fdd-lite/hooks/analytics/runs
}
# Live values NF pushes (PointManager.ObserveDataUpdates, read-only, one long
# chunked response). Flush every chunk at once instead of buffering it.
@liveStream {
	method GET
	path /api/v1/point/updates/data
}
# The app listing carries options (a database URL can sit there). The tuning hook's
# one POST both reads and saves. Anonymous callers get 403 and no login dialog;
# a presented credential is checked, and a wrong one is still a 401.
@appList {
	method GET HEAD
	path /api/v1/apps
}
@tuningPost {
	method POST
	path /api/v1/apps/open-fdd/hooks/tuning /api/v1/apps/open-fdd-lite/hooks/tuning
}

# Access log: one JSON line per request, rolled by size, secrets redacted.
#   - Authorization / Cookie / Set-Cookie headers and token-like query parameters never reach the file.
#   - Bounded: 5 MiB per file, 5 files kept, nothing older than 30 days (roll_*), on the caddy_logs volume.
#   - Not logged at all (log_skip): browser icons and the live stream (one line per ~15 s per open tab,
#     it would push everything useful out of the 5 files).
# Everything that needs a decision (who got in, what was written, which status) is in the file.
log_skip @browserIcons
log_skip @liveStream
log {
	output file {$CADDY_ACCESS_LOG:/var/log/caddy/access.log} {
		roll_size 5MiB
		roll_keep 5
		roll_keep_for 720h
	}
	format filter {
		wrap json
		request>headers>Authorization replace REDACTED
		request>headers>Proxy-Authorization replace REDACTED
		request>headers>Cookie replace REDACTED
		resp_headers>Set-Cookie replace REDACTED
		request>uri query {
			replace token REDACTED
			replace access_token REDACTED
			replace id_token REDACTED
			replace refresh_token REDACTED
			replace jwt REDACTED
			replace api_key REDACTED
			replace apikey REDACTED
			replace client_secret REDACTED
			replace secret REDACTED
			replace password REDACTED
			replace sig REDACTED
			replace code REDACTED
		}
	}
}

# Security headers on every response (ZAP baseline: clickjacking, MIME sniffing, permissions).
# frame-ancestors can't be set from the pages' <meta> CSP, so it lives here; the meta CSP still
# governs scripts/styles. NF's console may frame its own pages, hence 'self' (not 'none').
header {
	X-Content-Type-Options "nosniff"
	X-Frame-Options "SAMEORIGIN"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), payment=()"
	Content-Security-Policy "frame-ancestors 'self'"
	-Server
}

# Compress everything except the live stream (it must flush chunk by chunk).
@compress not path /api/v1/point/updates/data
encode @compress gzip

handle @liveStream {
	reverse_proxy {$NF_UPSTREAM} {
		flush_interval -1
		# Why this rewrite exists: NF's Envoy closes a push stream that has been quiet for ~15 s
		# ("upstream request timeout", HTTP 504). That is Envoy's normal idle close, not an outage:
		# nf.js reopens the stream at once. Without the rewrite every such reconnect shows up as a
		# red 504 in the browser console and the network tab. ONLY upstream 504s on this one route
		# are rewritten (to an empty 204), so an Envoy 504 for any other reason on this route is
		# hidden too; a real outage is not hidden by it: NF down or Caddy
		# unreachable gives connection errors (502 from Caddy, refused/reset), and the page
		# reports the failed reconnects ("live" turns off and backs off 2 s .. 60 s).
		@quiet status 504
		handle_response @quiet {
			respond 204
		}
	}
}
handle @appStatic {
	reverse_proxy {$NF_UPSTREAM}
}
handle @readGet {
	reverse_proxy {$NF_UPSTREAM}
}
handle @readPost {
	reverse_proxy {$NF_UPSTREAM}
}
handle @hookRuns {
	reverse_proxy {$NF_UPSTREAM}
}
# Optional login: no header means 403 and no WWW-Authenticate (the dashboard's fetch fails
# and the browser stays quiet). A Basic credential is checked before the request is proxied.
handle @appList {
	route {
		@appListCred header Authorization *
		handle @appListCred {
			basic_auth {
				import auth.caddy
			}
			reverse_proxy {$NF_UPSTREAM}
		}
		handle {
			respond 403
		}
	}
}
handle @tuningPost {
	route {
		@tuningCred header Authorization *
		handle @tuningCred {
			basic_auth {
				import auth.caddy
			}
			reverse_proxy {$NF_UPSTREAM}
		}
		handle {
			respond 403
		}
	}
}
handle {
	basic_auth {
		import auth.caddy
	}
	reverse_proxy {$NF_UPSTREAM}
}
