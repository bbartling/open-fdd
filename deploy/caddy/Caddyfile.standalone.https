# Astra A03 mode: provided — operator-supplied leaf + key under /certs.
# Set OPENFDD_PUBLIC_HOST to the canonical authority hostname clients use.
# Port 80 is redirect-only — never reverse_proxy login over plaintext.

http://{$OPENFDD_PUBLIC_HOST} {
	redir https://{host}{uri} permanent
}

{$OPENFDD_PUBLIC_HOST} {
	encode gzip
	tls /certs/server.crt /certs/server.key

	reverse_proxy central:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
