# Astra A03 mode: lab — disposable self-signed leaf under /certs (lab only).
# Explicit trust required; cannot close production or Nessus certificate acceptance.
# Set OPENFDD_PUBLIC_HOST; never disable TLS verification to obtain a pass.

http://{$OPENFDD_PUBLIC_HOST} {
	redir https://{host}{uri} permanent
}

{$OPENFDD_PUBLIC_HOST} {
	encode gzip
	tls /certs/lab.crt /certs/lab.key

	reverse_proxy web:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
