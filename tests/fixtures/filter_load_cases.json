{
  "_doc": "#1783 FILTER-LOAD cases, shared by nf-app/tests/filter-load.test.mjs (PGlite, SQLite) and tests/test_filter_load.py (pandas, DuckDB, PostgreSQL). Each case: `n` samples (default 97 = 8 h) at 5 min of the values in `row` (SQL role names, SI), with `second_half` overriding them from sample n // 2 on. `expect` = fault hours with the default 20 min confirmation (the held time of the first three samples of a streak is not fault time: 93 x 5 min = 7.75 h over 8 h), or the SQL assessment of a not-assessed equipment; `path` = the SQL filter_path (assessment 'assessed').",
  "cases": [
    {"id": "dp_high_fault", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "filter_dp": 350.0}, "expect": 7.75, "path": "filter_dp"},
    {"id": "dp_low_pass", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "filter_dp": 80.0}, "expect": 0.0, "path": "filter_dp"},
    {"id": "dp_at_limit_pass", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "filter_dp": 248.84}, "expect": 0.0, "path": "filter_dp"},
    {"id": "dp_just_above_limit", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "filter_dp": 248.85}, "expect": 7.75, "path": "filter_dp"},
    {"id": "dp_without_airflow", "row": {"run_proof": 1, "fan_status": 1, "filter_dp": 350.0}, "expect": 7.75, "path": "filter_dp"},
    {"id": "fan_off_leftover_dp", "row": {"run_proof": 1, "fan_status": 0, "zone_flow": 0.0, "filter_dp": 350.0}, "expect": 0.0, "path": "filter_dp"},
    {"id": "proof_off", "row": {"run_proof": 0, "fan_status": 1, "zone_flow": 2000.0, "filter_dp": 350.0}, "expect": 0.0, "path": "filter_dp"},
    {"id": "low_airflow_half_not_a_fault", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "filter_dp": 350.0}, "second_half": {"zone_flow": 500.0}, "expect": 3.75, "path": "filter_dp"},
    {"id": "implausible_dp_is_a_sensor_problem", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "filter_dp": 3000.0}, "expect": 0.0, "path": "filter_dp"},
    {"id": "dp_wins_over_fan_effort", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "filter_dp": 80.0, "fan_power": 5.0}, "second_half": {"fan_power": 8.0}, "expect": 0.0, "path": "filter_dp"},
    {"id": "fan_effort_rises", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "fan_power": 5.0}, "second_half": {"fan_power": 8.0}, "expect": 3.75, "path": "fan_effort"},
    {"id": "fan_effort_below_ratio", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "fan_power": 5.0}, "second_half": {"fan_power": 6.4}, "expect": 0.0, "path": "fan_effort"},
    {"id": "fan_effort_flat", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "fan_power": 5.0}, "expect": 0.0, "path": "fan_effort"},
    {"id": "fan_effort_thin_baseline", "n": 37, "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0, "fan_power": 5.0}, "second_half": {"fan_power": 8.0}, "expect": "insufficient_baseline"},
    {"id": "power_without_airflow", "row": {"run_proof": 1, "fan_status": 1, "fan_power": 5.0}, "expect": "no_filter_inputs"},
    {"id": "no_filter_inputs", "row": {"run_proof": 1, "fan_status": 1, "zone_flow": 2000.0}, "expect": "no_filter_inputs"}
  ]
}
