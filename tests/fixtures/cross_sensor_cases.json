    {"id": "clip_static_fan_on", "rule": "XS-CLIP", "row": {"fan_status": 1, "duct_static": {"cycle": [212.3, 287.6, 500.0, 500.0]}}, "expect": 4.0},
    {"id": "clip_airflow_design_max_once", "rule": "XS-CLIP", "row": {"run_proof": 1, "zone_flow": {"cycle": [120.0, 180.0, 210.0]}}, "set": {"zone_flow": {"10": 471.9}}, "expect": 0.0},
    {"id": "clip_airflow_round", "rule": "XS-CLIP", "row": {"zone_flow": {"cycle": [120.0, 250.0, 250.0, 180.0]}}, "expect": 4.0},
    {"id": "clip_no_role", "rule": "XS-CLIP", "row": {"zone_t": 21.0}, "expect": "no_clip_role"}
  ]
}
