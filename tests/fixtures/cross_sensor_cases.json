{
  "_doc": "#1780 cross-sensor cases (XS-MIX, XS-COPY, XS-CLIP), shared by tests/test_cross_sensor.py (pandas, SQLite, DuckDB and, when configured, PostgreSQL). Each case: 8 h at 5 min (97 samples, index i = 0..96) of `row` (SQL role names, SI). A value is a constant, {ramp: [a, b]} = a + b*i, {cycle: [...]} = values[i mod len], {copy: role, plus: x} = that role + x, or {before: v, from: k, value: w} = v for i < k else w; `set` = {role: {i: value}} overrides. `expect` = fault hours (the last sample holds no time; XS-MIX confirms after 15 min, XS-COPY after 2 h, XS-CLIP at once), or the SQL assessment of an equipment that is not assessed.",
  "cases": [
    {"id": "mix_above_envelope", "rule": "XS-MIX", "row": {"run_proof": 1, "fan_status": 1, "oa_t": 30.0, "rat": 22.0, "mat": 33.0}, "expect": 7.833333},
    {"id": "mix_below_envelope", "rule": "XS-MIX", "row": {"run_proof": 1, "fan_status": 1, "oa_t": 0.0, "rat": 22.0, "mat": -3.0}, "expect": 7.833333},
    {"id": "mix_acceptance_3k_outside", "rule": "XS-MIX", "row": {"run_proof": 1, "fan_cmd": 0.6, "oa_t": 5.0, "rat": 22.0, "mat": 25.0}, "expect": 7.833333},
    {"id": "mix_inside", "rule": "XS-MIX", "row": {"run_proof": 1, "fan_status": 1, "oa_t": 5.0, "rat": 22.0, "mat": 12.0}, "expect": 0.0},
    {"id": "mix_inside_band", "rule": "XS-MIX", "row": {"run_proof": 1, "fan_status": 1, "oa_t": 30.0, "rat": 22.0, "mat": 31.0}, "expect": 0.0},
    {"id": "mix_fan_off", "rule": "XS-MIX", "row": {"run_proof": 1, "fan_status": 0, "oa_t": 30.0, "rat": 22.0, "mat": 33.0}, "expect": 0.0},
    {"id": "mix_proof_off", "rule": "XS-MIX", "row": {"run_proof": 0, "oa_t": 30.0, "rat": 22.0, "mat": 33.0}, "expect": 0.0},
    {"id": "mix_shorter_than_confirm", "rule": "XS-MIX", "row": {"run_proof": 1, "fan_status": 1, "oa_t": 30.0, "rat": 22.0, "mat": {"before": 33.0, "from": 2, "value": 25.0}}, "expect": 0.0},
    {"id": "mix_no_run_proof", "rule": "XS-MIX", "row": {"fan_status": 1, "oa_t": 30.0, "rat": 22.0, "mat": 33.0}, "expect": "no_run_proof"},
    {"id": "mix_no_rat", "rule": "XS-MIX", "row": {"run_proof": 1, "fan_status": 1, "oa_t": 30.0, "mat": 33.0}, "expect": "no_temperatures"},
    {"id": "copy_rat_from_sat", "rule": "XS-COPY", "row": {"oa_t": {"ramp": [5.0, 0.02]}, "sat": {"ramp": [12.0, 0.1]}, "rat": {"copy": "sat", "plus": 0.005}}, "expect": 6.083333},
    {"id": "copy_mat_from_rat", "rule": "XS-COPY", "row": {"sat": 13.0, "rat": {"ramp": [20.0, -0.05]}, "mat": {"copy": "rat", "plus": 0.0}}, "expect": 6.083333},
    {"id": "copy_zone_vav_discharge", "rule": "XS-COPY", "row": {"zone_t": {"ramp": [20.0, 0.03]}, "vav_discharge_t": {"copy": "zone_t", "plus": -0.01}}, "expect": 6.083333},
    {"id": "copy_flat_pair_is_flatline", "rule": "XS-COPY", "row": {"sat": 13.0, "rat": 13.0}, "expect": 0.0},
    {"id": "copy_just_outside_tol", "rule": "XS-COPY", "row": {"sat": {"ramp": [12.0, 0.1]}, "rat": {"copy": "sat", "plus": 0.03}}, "expect": 0.0},
    {"id": "copy_independent", "rule": "XS-COPY", "row": {"sat": {"ramp": [12.0, 0.1]}, "rat": {"ramp": [22.0, -0.02]}}, "expect": 0.0},
